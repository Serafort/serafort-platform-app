# API Configuration
VITE_API_URL=
VITE_API_PREFIX=/api
# Client-Side Storage Obfuscation Key (IndexedDB / localStorage local at-rest cache obfuscation)
# Note: Inlined into public JS bundle; used exclusively for client offline cache obfuscation.
VITE_STORAGE_ENCRYPTION_KEY=your_rotated_32byte_hex_key_here
VITE_API_VERSION=v1
VITE_TENANT_ID=default
VITE_APP_NAME=Cap
VITE_APP_DESCRIPTION=TrustKey Platform
VITE_APP_VERSION=1.0.0
VITE_API_TIMEOUT=51730

# Environment
NODE_ENV=development

# Local-dev sign-in form prefill ONLY. Compiled out of production builds.
# Leave blank unless you want the login form pre-filled during `vite` dev.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=
