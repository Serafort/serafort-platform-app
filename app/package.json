{
  "name": "@cap/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "build:check": "tsc && vite build",
    "build:analyze": "vite build --mode analyze",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "analyze": "npm run build && npx vite-bundle-visualizer",
    "analyze:stats": "vite build --mode analyze && npx vite-bundle-visualizer",
    "lighthouse": "lighthouse http://localhost:5173 --view --output html --output-path ./lighthouse-report.html",
    "lighthouse:ci": "lhci autorun",
    "perf:build": "npm run build && npm run analyze",
    "perf:profile": "node --inspect-brk ./node_modules/.bin/vite build",
    "size": "npm run build && size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "npm run build && npm run lighthouse",
    "validate:isolation": "npm run lint --workspace=@cap/theme",
    "validate:types": "npm run type-check",
    "prepare": "node -e \"try { require('husky').default() } catch (e) { if (e.code !== 'MODULE_NOT_FOUND') throw e }\" || true"
  },
  "dependencies": {
    "@cap/layout": "workspace:*",
    "@cap/module-auth": "workspace:*",
    "@cap/module-dashboard": "workspace:*",
    "@cap/module-landing": "workspace:*",
    "@cap/module-theme": "workspace:*",
    "@cap/platform-core": "workspace:*",
    "@cap/shared-types": "workspace:*",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@floating-ui/react": "^0.27.16",
    "@hookform/resolvers": "^5.2.2",
    "@iconify/react": "^6.0.2",
    "@mui/icons-material": "^7.3.6",
    "@mui/lab": "^7.0.1-beta.20",
    "@mui/material": "^7.3.6",
    "@react-router/node": "^7.13.1",
    "@react-router/serve": "^7.13.1",
    "@reactour/tour": "^3.8.0",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.13",
    "@types/crypto-js": "^4.2.2",
    "classnames": "^2.5.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "immer": "^11.0.1",
    "isbot": "^5",
    "kbar": "^0.1.0-beta.48",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.69.0",
    "react-i18next": "^16.5.0",
    "react-imask": "^7.6.1",
    "react-joyride": "^2.9.3",
    "react-perfect-scrollbar": "^1.5.8",
    "react-phone-input-2": "^2.15.1",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "react-toastify": "^11.0.5",
    "react-use": "^17.6.0",
    "recharts": "^3.6.0",
    "stylis-plugin-rtl": "^2.1.1",
    "tiny-invariant": "^1.3.3",
    "uuid": "^13.0.0",
    "workbox-window": "^7.4.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@hookform/devtools": "^4.4.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@react-router/dev": "^7.13.1",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/classnames": "^2.3.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.0.1",
    "lightningcss": "^1.30.2",
    "lint-staged": "^16.2.7",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.50.1",
    "validate-branch-name": "^1.3.2",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "react-is": "19.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "npm run lint",
      "npm run validate:types"
    ]
  }
}

