{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "app/*": ["./src/*"],
      "src/*": ["./src/*"],
      "@/routes": ["../packages/modules/auth/src/routes", "../packages/platform-core/src/stubs/auth-shim.tsx"],
      "@/routes/*": ["../packages/modules/auth/src/routes/*", "../packages/platform-core/src/stubs/auth-shim.tsx"],
      "@/modules": ["../packages/modules/auth/src/modules", "../packages/platform-core/src/stubs/auth-shim.tsx"],
      "@/modules/*": ["../packages/modules/auth/src/modules/*", "../packages/platform-core/src/stubs/auth-shim.tsx"],
      "@cap/layout": ["../packages/layout/src"],
      "@cap/layout/*": ["../packages/layout/src/*"],
      "@cap/theme": ["../packages/theme/src"],
      "@cap/theme/*": ["../packages/theme/src/*"],
      "@cap/module-auth": [
        "../packages/modules/auth/src",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@cap/module-auth/*": [
        "../packages/modules/auth/src/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@cap/module-admin": ["../packages/modules/admin/src"],
      "@cap/module-admin/*": ["../packages/modules/admin/src/*"],
      "@cap/module-landing": ["../packages/modules/landing/src"],
      "@cap/module-landing/*": ["../packages/modules/landing/src/*"],
      "@cap/module-theme": ["../packages/modules/theme/src"],
      "@cap/module-theme/*": ["../packages/modules/theme/src/*"],
      "@cap/module-widget-studio": ["../packages/modules/widget-studio/src"],
      "@cap/module-widget-studio/*": ["../packages/modules/widget-studio/src/*"],
      "@cap/module-mfa": ["../packages/modules/mfa/src"],
      "@cap/module-mfa/*": ["../packages/modules/mfa/src/*"],
      "@cap/platform-core": ["../packages/platform-core/src"],
      "@cap/platform-core/*": ["../packages/platform-core/src/*"],
      "@cap/module-civil-registry": ["../packages/modules/civil-registry/src"],
      "@cap/module-civil-registry/*": ["../packages/modules/civil-registry/src/*"],
      "@cap/shared-types": ["../packages/shared-types/src"],
      "@cap/shared-types/*": ["../packages/shared-types/src/*"],
      "@auth/authentication-core": [
        "../packages/modules/auth/src/modules/authentication-core",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/authentication-core/*": [
        "../packages/modules/auth/src/modules/authentication-core/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/authorization-engine": [
        "../packages/modules/auth/src/modules/authorization-engine",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/authorization-engine/*": [
        "../packages/modules/auth/src/modules/authorization-engine/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/identity-broker": [
        "../packages/modules/auth/src/modules/identity-broker",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/identity-broker/*": [
        "../packages/modules/auth/src/modules/identity-broker/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/mfa-orchestrator": [
        "../packages/modules/auth/src/modules/mfa-orchestrator",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/mfa-orchestrator/*": [
        "../packages/modules/auth/src/modules/mfa-orchestrator/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/passwordless-service": [
        "../packages/modules/auth/src/modules/passwordless-service",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/passwordless-service/*": [
        "../packages/modules/auth/src/modules/passwordless-service/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/platform-cluster": [
        "../packages/modules/auth/src/modules/platform-cluster",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/platform-cluster/*": [
        "../packages/modules/auth/src/modules/platform-cluster/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/session-manager": [
        "../packages/modules/auth/src/modules/session-manager",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/session-manager/*": [
        "../packages/modules/auth/src/modules/session-manager/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/user-directory": [
        "../packages/modules/auth/src/modules/user-directory",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/user-directory/*": [
        "../packages/modules/auth/src/modules/user-directory/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/domain-kernel": [
        "../packages/modules/auth/src/domain-kernel",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth/domain-kernel/*": [
        "../packages/modules/auth/src/domain-kernel/*",
        "../packages/platform-core/src/stubs/auth-shim.tsx"
      ],
      "@auth": ["../packages/modules/auth/src", "../packages/platform-core/src/stubs/auth-shim.tsx"],
      "@auth/*": ["../packages/modules/auth/src/*", "../packages/platform-core/src/stubs/auth-shim.tsx"],
      "@idaas": ["../packages/modules/auth/src/modules", "../packages/platform-core/src/stubs/auth-shim.tsx"],
      "@idaas/*": ["../packages/modules/auth/src/modules/*", "../packages/platform-core/src/stubs/auth-shim.tsx"],
      "src/configs/*": ["../packages/platform-core/src/configs/*"],
      "src/types/*": ["../packages/platform-core/src/types/*"],
      "src/theme/*": ["../packages/platform-core/src/theme/*"]
    },
    "types": ["react", "vite/client", "node"]
  },
  "include": ["src", ".react-router"]
}
