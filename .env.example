# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: All VITE_* variables are embedded into the public JS bundle at
# build time. DO NOT store API keys, secrets, or credentials here.
# ─────────────────────────────────────────────────────────────────────────────

# ─── API Configuration ────────────────────────────────────────────────────────
VITE_API_URL=
VITE_API_PREFIX=/api
VITE_API_VERSION=v1
VITE_API_TIMEOUT=15000

# ─── App Identity ─────────────────────────────────────────────────────────────
VITE_APP_NAME=Cap
VITE_APP_DESCRIPTION=TrustKey Platform
VITE_APP_VERSION=1.0.0
VITE_TENANT_ID=default

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Client-Side Storage Obfuscation ──────────────────────────────────────────
# Used exclusively for at-rest obfuscation of local IndexedDB/localStorage cache.
# This is NOT encryption — it is inlined into the public bundle. Rotate periodically.
VITE_STORAGE_ENCRYPTION_KEY=your_rotated_32byte_hex_key_here

# ─── Error Monitoring (optional) ──────────────────────────────────────────────
# Leave blank to disable. Set in production to capture frontend errors.
VITE_SENTRY_DSN=

# ─── AI Multi-Agent & Theme Pipelines ─────────────────────────────────────────
# AI provider execution is managed server-side via backend /api/v1/widgets/generate
# Configure GEMINI_API_KEY / OPENROUTER_API_KEY in Authentication/.env (never here)
