{
  "name": "cap-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @cap/app run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:circular": "npx madge --circular --extensions ts,tsx --exclude dist ./app/src ./packages/shared-types/src ./packages/api-contracts/src ./packages/platform-store/src ./packages/theme/src ./packages/auth-contracts/src ./packages/authorization/src ./packages/platform-core/src ./packages/layout/src ./packages/modules/auth/src ./packages/modules/dashboard/src ./packages/modules/landing/src ./packages/modules/theme/src ./packages/modules/widget-studio/src",
    "lint:circular:graph": "npx madge --circular --image graph.svg --extensions ts,tsx --exclude dist ./app/src ./packages/shared-types/src ./packages/api-contracts/src ./packages/platform-store/src ./packages/theme/src ./packages/auth-contracts/src ./packages/authorization/src ./packages/platform-core/src ./packages/layout/src ./packages/modules/auth/src ./packages/modules/dashboard/src ./packages/modules/landing/src ./packages/modules/theme/src ./packages/modules/widget-studio/src",
    "test:e2e": "pnpm --filter @cap/app run test:e2e",
    "cspell": "cspell --no-progress --show-suggestions --relative --dot --gitignore \"**\"",
    "audit:ci": "pnpm audit --audit-level=high --prod",
    "release:package": "node scripts/package-release.mjs",
    "release:build": "pnpm --filter @cap/app run build && node scripts/package-release.mjs",
    "generate:module": "plop",
    "lint:boundaries": "node scripts/check-tier-boundaries.mjs",
    "lint:architecture": "pnpm lint:boundaries && pnpm lint:circular"
  },
  "dependencies": {
    "@mui/utils": "^7.3.9",
    "@tanstack/react-query": "^5.99.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint-plugin-import": "^2.32.0",
    "madge": "^8.0.0",
    "plop": "^4.0.1",
    "typescript": "^5.7.3",
    "vite-plugin-pwa": "^1.2.0"
  },
  "pnpm": {
    "overrides": {
      "js-cookie": "^3.0.8",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.18",
      "undici": "^7.29.0",
      "serialize-javascript": "^7.0.5",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^2": "^2.1.4",
      "ws": "^8.21.0",
      "tmp": "^0.2.6",
      "basic-ftp": "^5.3.1",
      "ip-address": "^10.3.1",
      "qs": "^6.15.2",
      "morgan": "^1.11.0",
      "js-yaml@^4": "^4.3.1",
      "vite": "^7.3.5",
      "@vitest/browser": "^4.1.10",
      "browserslist": ">=4.28.7",
      "js-yaml@^3": "^3.15.2",
      "@babel/core": "^7.29.7",
      "body-parser": "^1.20.6",
      "valibot": "^1.4.2",
      "@humanfs/node": "^0.16.8",
      "esbuild": "^0.28.2",
      "uuid": "^11.1.1"
    },
    "auditConfig": {
      "//": "extract-zip: no fixed release exists upstream (advisory patched_version is null); reached only through the @lhci/cli > lighthouse > puppeteer-core dev chain (never shipped to production). js-yaml 3.x: was EOL with no 3.15.x release when this comment was first written, but the maintainers have since published 3.15.0-3.15.2 (2026-06 through 2026-08); pinned via the `js-yaml@^3` override above instead of ignored. The blocking `audit:ci` gate runs with --prod and does not see either path.",
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv"
      ]
    }
  }
}
