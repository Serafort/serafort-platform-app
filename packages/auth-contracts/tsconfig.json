{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@cap/theme": ["../theme/src"],
      "@cap/theme/*": ["../theme/src/*"],
      "@cap/platform-core": ["../platform-core/src"],
      "@cap/platform-core/*": ["../platform-core/src/*"],
      "@cap/platform-store": ["../platform-store/src"],
      "@cap/platform-store/*": ["../platform-store/src/*"],
      "@cap/shared-types": ["../shared-types/src"],
      "@cap/shared-types/*": ["../shared-types/src/*"],
      "@cap/api-contracts": ["../api-contracts/src"],
      "@cap/api-contracts/*": ["../api-contracts/src/*"]
    }
  },
  "include": ["src/**/*"]
}
