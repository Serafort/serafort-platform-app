{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "react", "react-dom"],
    "paths": {
      "@cap/auth-contracts": ["../../auth-contracts/src"],
      "@cap/auth-contracts/*": ["../../auth-contracts/src/*"],
      "@cap/platform-core": ["../../platform-core/src"],
      "@cap/platform-core/*": ["../../platform-core/src/*"],
      "@cap/platform-store": ["../../platform-store/src"],
      "@cap/platform-store/*": ["../../platform-store/src/*"],
      "@cap/shared-types": ["../../shared-types/src"],
      "@cap/shared-types/*": ["../../shared-types/src/*"],
      "@cap/theme": ["../../theme/src"],
      "@cap/theme/*": ["../../theme/src/*"],
      "@cap/layout": ["../../layout/src"],
      "@cap/layout/*": ["../../layout/src/*"],
      "@cap/authorization": ["../../authorization/src"],
      "@cap/authorization/*": ["../../authorization/src/*"],
      "@cap/module-auth": ["./src"],
      "@cap/module-auth/*": ["./src/*"],
      "@/": ["./src"],
      "@/*": ["./src/*"],
      "@auth": ["./src"],
      "@auth/*": ["./src/*"],
      "@auth/authentication-core": ["./src/modules/authentication-core"],
      "@auth/authentication-core/*": ["./src/modules/authentication-core/*"],
      "@auth/authorization-engine": ["./src/modules/authorization-engine"],
      "@auth/authorization-engine/*": ["./src/modules/authorization-engine/*"],
      "@auth/identity-broker": ["./src/modules/identity-broker"],
      "@auth/identity-broker/*": ["./src/modules/identity-broker/*"],
      "@auth/mfa-orchestrator": ["./src/modules/mfa-orchestrator"],
      "@auth/mfa-orchestrator/*": ["./src/modules/mfa-orchestrator/*"],
      "@auth/passwordless-service": ["./src/modules/passwordless-service"],
      "@auth/passwordless-service/*": ["./src/modules/passwordless-service/*"],
      "@auth/platform-cluster": ["./src/modules/platform-cluster"],
      "@auth/platform-cluster/*": ["./src/modules/platform-cluster/*"],
      "@auth/session-manager": ["./src/modules/session-manager"],
      "@auth/session-manager/*": ["./src/modules/session-manager/*"],
      "@auth/user-directory": ["./src/modules/user-directory"],
      "@auth/user-directory/*": ["./src/modules/user-directory/*"],
      "@auth/domain-kernel": ["./src/domain-kernel"],
      "@auth/domain-kernel/*": ["./src/domain-kernel/*"],
      "@idaas/*": ["./src/modules/*"]
    }
  },
  "include": ["./src/**/*"]
}
