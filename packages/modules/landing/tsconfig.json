{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@cap/auth-contracts": ["../../auth-contracts/src"],
      "@cap/auth-contracts/*": ["../../auth-contracts/src/*"],
      "@cap/platform-core": ["../../platform-core/src"],
      "@cap/platform-core/*": ["../../platform-core/src/*"],
      "@cap/platform-store": ["../../platform-store/src"],
      "@cap/platform-store/*": ["../../platform-store/src/*"],
      "@cap/shared-types": ["../../shared-types/src"],
      "@cap/shared-types/*": ["../../shared-types/src/*"],
      "@cap/theme": ["../../theme/src"],
      "@cap/theme/*": ["../../theme/src/*"],
      "@cap/layout": ["../../layout/src"],
      "@cap/layout/*": ["../../layout/src/*"],
      "@cap/module-auth": ["../auth/src", "../../platform-core/src/stubs/auth-shim.tsx"],
      "@cap/module-auth/*": ["../auth/src/*", "../../platform-core/src/stubs/auth-shim.tsx"],
      "@auth": ["../auth/src", "../../platform-core/src/stubs/auth-shim.tsx"],
      "@auth/*": ["../auth/src/*", "../../platform-core/src/stubs/auth-shim.tsx"],
      "@auth/authentication-core/*": ["../auth/src/modules/authentication-core/*"],
      "@auth/authorization-engine/*": ["../auth/src/modules/authorization-engine/*"],
      "@auth/identity-broker/*": ["../auth/src/modules/identity-broker/*"],
      "@auth/mfa-orchestrator/*": ["../auth/src/modules/mfa-orchestrator/*"],
      "@auth/passwordless-service/*": ["../auth/src/modules/passwordless-service/*"],
      "@auth/platform-cluster/*": ["../auth/src/modules/platform-cluster/*"],
      "@auth/session-manager/*": ["../auth/src/modules/session-manager/*"],
      "@auth/user-directory/*": ["../auth/src/modules/user-directory/*"],
      "@auth/domain-kernel/*": ["../auth/src/domain-kernel/*"],
      "@idaas/*": ["../auth/src/modules/*"]
    },
    "types": ["react", "react-dom", "node", "vite/client"]
  },
  "include": ["src"]
}
