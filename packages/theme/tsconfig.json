{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "paths": {
      "@cap/theme": ["./src"],
      "@cap/theme/*": ["./src/*"],
      "@cap/layout": ["../layout/src"],
      "@cap/layout/*": ["../layout/src/*"],
      "@cap/module-auth": [
        "../modules/auth/src",
        "../platform-core/src/stubs/auth-shim.tsx"
      ],
      "@cap/module-auth/*": [
        "../modules/auth/src/*",
        "../platform-core/src/stubs/auth-shim.tsx"
      ],
      "@cap/platform-core": ["../platform-core/src"],
      "@cap/platform-core/*": ["../platform-core/src/*"],
      "@cap/platform-store": ["../platform-store/src"],
      "@cap/platform-store/*": ["../platform-store/src/*"],
      "@cap/shared-types": ["../shared-types/src"],
      "@cap/shared-types/*": ["../shared-types/src/*"]
    },

    "types": ["node", "vite/client", "react", "react-dom", "classnames", "react-use"]
  },
  "include": ["src/**/*", "vite-env.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
