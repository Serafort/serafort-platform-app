{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["react", "node", "vite/client"],
    "paths": {
      "@cap/shared-types": ["../shared-types/src"],
      "@cap/shared-types/*": ["../shared-types/src/*"],
      "@cap/platform-core": ["../platform-core/src"],
      "@cap/platform-core/*": ["../platform-core/src/*"],
      "@cap/platform-store": ["../platform-store/src"],
      "@cap/platform-store/*": ["../platform-store/src/*"],
      "@cap/authorization": ["./src"],
      "@cap/authorization/*": ["./src/*"]
    },
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
