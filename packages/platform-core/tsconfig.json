{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@cap/platform-core": ["./src"],
      "@cap/platform-core/*": ["./src/*"],
      "@cap/module-auth": ["../modules/auth/src", "../platform-core/src/stubs/auth-shim.tsx"],
      "@cap/module-auth/*": ["../modules/auth/src/*", "../platform-core/src/stubs/auth-shim.tsx"],
      "@cap/layout": ["../layout/src"],
      "@cap/layout/*": ["../layout/src/*"],
      "@cap/authorization": ["../authorization/src"],
      "@cap/authorization/*": ["../authorization/src/*"],
      "@cap/shared-types": ["../shared-types/src"],
      "@cap/shared-types/*": ["../shared-types/src/*"],
      "@cap/platform-store": ["../platform-store/src"],
      "@cap/platform-store/*": ["../platform-store/src/*"],
      "@cap/module-theme": ["../modules/theme/src"],
      "@cap/module-theme/*": ["../modules/theme/src/*"],
      "@cap/theme": ["../theme/src"],
      "@cap/theme/*": ["../theme/src/*"],
      "@auth": ["../modules/auth/src"],
      "@auth/*": ["../modules/auth/src/*"],
      "@auth/authentication-core": ["../modules/auth/src/modules/authentication-core"],
      "@auth/authentication-core/*": ["../modules/auth/src/modules/authentication-core/*"],
      "@auth/authorization-engine": ["../modules/auth/src/modules/authorization-engine"],
      "@auth/authorization-engine/*": ["../modules/auth/src/modules/authorization-engine/*"],
      "@auth/identity-broker": ["../modules/auth/src/modules/identity-broker"],
      "@auth/identity-broker/*": ["../modules/auth/src/modules/identity-broker/*"],
      "@auth/mfa-orchestrator": ["../modules/auth/src/modules/mfa-orchestrator"],
      "@auth/mfa-orchestrator/*": ["../modules/auth/src/modules/mfa-orchestrator/*"],
      "@auth/passwordless-service": ["../modules/auth/src/modules/passwordless-service"],
      "@auth/passwordless-service/*": ["../modules/auth/src/modules/passwordless-service/*"],
      "@auth/platform-cluster": ["../modules/auth/src/modules/platform-cluster"],
      "@auth/platform-cluster/*": ["../modules/auth/src/modules/platform-cluster/*"],
      "@auth/session-manager": ["../modules/auth/src/modules/session-manager"],
      "@auth/session-manager/*": ["../modules/auth/src/modules/session-manager/*"],
      "@auth/user-directory": ["../modules/auth/src/modules/user-directory"],
      "@auth/user-directory/*": ["../modules/auth/src/modules/user-directory/*"],
      "@auth/domain-kernel": ["../modules/auth/src/domain-kernel"],
      "@auth/domain-kernel/*": ["../modules/auth/src/domain-kernel/*"],
      "@idaas/*": ["../modules/auth/src/modules/*"]
    },
    "types": ["react", "node", "vite/client"]
  },
  "include": ["src/**/*", "vite-env.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
