# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT TEMPLATE
#
# Copy to `.env.production` (or inject via your deploy platform) and fill in
# every value below before a production build. `.env.production` is gitignored;
# this template is committed as deployment documentation.
#
# CRITICAL: Every VITE_* variable is inlined verbatim into the public browser
# bundle at build time. NEVER put API keys, secrets, database credentials, or
# passwords in any VITE_* value.
# ─────────────────────────────────────────────────────────────────────────────

# ─── API Configuration ───────────────────────────────────────────────────────
# REQUIRED. Must be an absolute https:// URL. The API client throws at startup
# if this is empty or non-HTTPS in a production build
# (packages/platform-store/src/services/api/api.client.ts).
VITE_API_URL=https://api.example.com/api
VITE_API_PREFIX=/api
VITE_API_VERSION=v1
# Request timeout in milliseconds. Keep this short (10–20s). Do not raise it to
# mask a slow backend — long timeouts degrade UX and widen DoS amplification.
VITE_API_TIMEOUT=15000

# ─── App Identity ────────────────────────────────────────────────────────────
VITE_APP_NAME=Cap
VITE_APP_DESCRIPTION=TrustKey Platform
VITE_APP_VERSION=1.0.0
# Default tenant slug used before the user selects/join a tenant.
VITE_TENANT_ID=default

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Client-Side Storage Obfuscation ─────────────────────────────────────────
# 32-byte hex value used ONLY for at-rest obfuscation of local
# IndexedDB/localStorage cache. This is NOT encryption — it ships in the public
# bundle. Generate a unique value per environment and rotate periodically:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_STORAGE_ENCRYPTION_KEY=

# ─── Error Monitoring ────────────────────────────────────────────────────────
# REQUIRED in production. The Sentry client (app/src/lib/sentry.ts) is a no-op
# when this is empty, so leaving it blank ships a build with no error tracking.
VITE_SENTRY_DSN=
# Optional: overrides the environment tag reported to Sentry (defaults to
# NODE_ENV / import.meta.env.MODE).
VITE_SENTRY_ENVIRONMENT=production
# Optional: 0.0–1.0 performance trace sample rate. Leave low in production.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── AI Multi-Agent & Theme Pipelines ────────────────────────────────────────
# AI provider execution is managed server-side via backend
# /api/v1/widgets/generate. Configure GEMINI_API_KEY / OPENROUTER_API_KEY in the
# backend (Authentication/.env), never here.
